{
  "manifest_version": 3,
  "name": "Kam Chai Nabirsa",
  "version": "0.1.0",
  "description": "Don't forget your work - floating to-do list, reminders, notes, and local media downloader.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Kam Chai Nabirsa",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/widget-css.js",
        "content/tabs/todo.js",
        "content/widget.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
